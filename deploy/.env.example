# GPUStack 二开版 compose 配置
# 复制为 .env 后按需修改

# 镜像 (deploy.sh 构建的本地镜像名)
GPUSTACK_IMAGE=gpustack-custom:latest

# Web UI / API 端口
GPUSTACK_PORT=8080

# 初始 admin 密码 (首次启动生效; 需含大小写/数字/特殊字符)
BOOTSTRAP_PASSWORD=admin

# 时区
TZ=Asia/Shanghai

# 内嵌 worker (单机一体模式; 关闭则纯 server, 需另接 worker 节点)
ENABLE_WORKER=true

# ---- 多机部署时: worker 注册 token (在 UI 集群页面生成) ----
# WORKER_TOKEN=
